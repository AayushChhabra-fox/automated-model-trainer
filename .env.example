# Databricks workspace + service-principal OAuth (M2M). Never commit real values.
DATABRICKS_HOST=https://adb-0000000000000000.0.azuredatabricks.net
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
# Or a PAT, which takes precedence over the pair above. Everything AMT submits then
# runs as that user, under their Unity Catalog grants; the token needs the `files`
# scope for the artifact Volume. An existing cluster must be single-user-pinned to
# the same identity, or its jobs will run with the wrong grants.
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=

# LLM for the local orchestrator agents. Any provider; base URL only for HTTP-compatible ones.
AMT_LLM_API_KEY=
AMT_LLM_BASE_URL=

# Unity Catalog destination for splits / artifacts
AMT_CATALOG=main
AMT_SCHEMA=amt
AMT_VOLUME_PATH=/Volumes/main/amt/amt_artifacts

# Compute: either a job-cluster spec ...
AMT_SPARK_VERSION=15.4.x-cpu-ml-scala2.12
AMT_NODE_TYPE_ID=Standard_DS3_v2
AMT_NUM_WORKERS=2
# ... or reuse an existing cluster (takes precedence when set)
AMT_EXISTING_CLUSTER_ID=

# MLflow. One experiment per campaign is created under the root; set an explicit id
# to send every job of every campaign to one existing experiment instead.
AMT_MLFLOW_EXPERIMENT_ROOT=/Shared/amt
AMT_MLFLOW_EXPERIMENT_ID=

# Per-agent models, as provider:model_id. Providers: openai, anthropic, huggingface,
# openai-compat. huggingface and openai-compat require AMT_LLM_BASE_URL.
#   openai:gpt-4.1
#   anthropic:claude-opus-5
#   huggingface:meta-llama/Llama-3.1-70B-Instruct
#   openai-compat:<served-model-name>
AMT_PLANNER_MODEL=openai:gpt-4.1
AMT_TRAINER_MODEL=openai:gpt-4.1
AMT_QA_MODEL=openai:gpt-4.1
AMT_PROBLEM_SPEC_MODEL=openai:gpt-4.1

# Orchestration
AMT_CHECKPOINT_DB=~/.amt/checkpoints.sqlite
