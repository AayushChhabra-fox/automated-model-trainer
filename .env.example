# Databricks workspace + service-principal OAuth (M2M). Never commit real values.
DATABRICKS_HOST=https://adb-0000000000000000.0.azuredatabricks.net
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
DATABRICKS_WAREHOUSE_ID=

# Anthropic
ANTHROPIC_API_KEY=

# Unity Catalog destination for splits / artifacts
AMT_CATALOG=main
AMT_SCHEMA=amt
AMT_VOLUME_PATH=/Volumes/main/amt/amt_artifacts

# Compute: either a job-cluster spec ...
AMT_SPARK_VERSION=15.4.x-cpu-ml-scala2.12
AMT_NODE_TYPE_ID=Standard_DS3_v2
AMT_NUM_WORKERS=2
# ... or reuse an existing cluster (takes precedence when set)
AMT_EXISTING_CLUSTER_ID=

# MLflow
AMT_MLFLOW_EXPERIMENT_ROOT=/Shared/amt

# Per-agent models
AMT_PLANNER_MODEL=claude-opus-5
AMT_TRAINER_MODEL=claude-opus-5
AMT_QA_MODEL=claude-opus-5
AMT_PROBLEM_SPEC_MODEL=claude-sonnet-5

# Orchestration
AMT_CHECKPOINT_DB=~/.amt/checkpoints.sqlite
